#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# hpc -- drive the Artemis HPC (University of Sussex) from this repo.
#
#   ./hpc check                 VPN + SSH reachability
#   ./hpc setup                 create the project dirs on the cluster
#   ./hpc push                  copy *.R / *.slurm to the cluster (CRLF -> LF)
#   ./hpc install [pkg...]      build the project R library on a compute node
#                               (naming a pkg force-reinstalls it, e.g. 'cogmod')
#   ./hpc precompile            pre-build the CmdStan precompiled header
#   ./hpc models                list the models defined in models.R
#   ./hpc fit <model|all> [..]  one array job per model (extra args -> sbatch)
#   ./hpc combine <model|all>   merge a model's shards, add loo
#   ./hpc predict <model|all>   posterior predictions of a combined model, for
#                               2_modelcomparison.qmd (extra args -> sbatch)
#   ./hpc priors [model|all]    priors against posteriors of every combined
#                               fit (or one model's), for 1_models.qmd; one job
#                               (IGC_PRIORS_FORCE=1 redoes up-to-date ones)
#   ./hpc archive [label]       move every fit (shards, combined/, predictions/,
#                               priors/) into models/old_<label>/, default
#                               today's date, so a refit can neither reuse nor
#                               overwrite them; refuses while igc_ jobs exist
#   ./hpc progress <model|all>  each running shard: iterations per chain, and
#                               once warmup is over, each chain's step size
#                               and lp__ level so far (a comma-separated list
#                               works too)
#   ./hpc queue                 squeue for this user
#   ./hpc log [jobid|model]     tail the newest .out/.err in scratch
#   ./hpc ls                    list fitted models on the cluster
#   ./hpc pull [pattern]        copy fitted .rds back into analysis/models/
#   ./hpc pull predictions      copy the prediction files into
#                               analysis/models/predictions/ (so does any
#                               pattern under predictions/, e.g.
#                               'predictions/gam_lnr_*.rds')
#   ./hpc pull priors           the same for analysis/models/priors/
#   ./hpc cancel <jobid|all>    scancel
#   ./hpc sh '<cmd>'            run an arbitrary command on the login node
#
# Everything is overridable by environment variable -- see the block below.
# A second account sets its own in analysis/server/hpc.local (gitignored);
# see README.md -> "Running from a second cluster account".
# ---------------------------------------------------------------------------
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Per-machine settings, so a second account needs no edit to a tracked file.
# Create analysis/server/hpc.local (gitignored) with, e.g.:
#     IGC_HPC_USER=oc236
# Anything already set in the environment still wins, so a one-off override on
# the command line beats the file.
if [ -f "${HERE}/hpc.local" ]; then
  # shellcheck disable=SC1090
  . "${HERE}/hpc.local"
fi

HPC_ALIAS="${IGC_HPC_ALIAS:-artemis}"            # Host entry in ~/.ssh/config
HPC_USER="${IGC_HPC_USER:-dmm56}"                # cluster account
HPC_GROUP="${IGC_HPC_GROUP:-psych}"              # school directory on lustre
PROJECT="${IGC_PROJECT:-IGComputational}"

USERS_DIR="${IGC_USERS_DIR:-/mnt/lustre/users/${HPC_GROUP}/${HPC_USER}/${PROJECT}}"
SCRATCH_DIR="${IGC_SCRATCH_DIR:-/mnt/lustre/scratch/${HPC_GROUP}/${HPC_USER}/${PROJECT}}"
MODELS_DIR="${IGC_MODELS_DIR:-${USERS_DIR}/models}"

# IGC_BACKEND=stanli (the 2026-10-17 speed test, fit_model.R "Backend") fits in
# stanli instead of cmdstanr. Its shards have the production names, so they go
# to models_stanli/ unless IGC_MODELS_DIR says otherwise, and its jobs and logs
# are igc_fit_<model>_stanli. Every command takes it: IGC_BACKEND=stanli ./hpc
# ls / combine / progress. stanli is 0.22.2 (from the RDM-5 test of
# 2026-10-20, AGENT.md 6.7), in a library of its own next to the benchmark's.
# The benchmark's library (cogmod_stanli/R_libs) holds the 0.21.0 of the LNR
# test (6.6): combine that one with IGC_STANLI_LIB=.../cogmod_stanli/R_libs.
# fit_model.R and combine_model.R refuse to mix shards of two stanli versions.
BACKEND="${IGC_BACKEND:-cmdstanr}"
BACKEND_SUFFIX=""
if [ "$BACKEND" = stanli ]; then
  MODELS_DIR="${IGC_MODELS_DIR:-${USERS_DIR}/models_stanli}"
  BACKEND_SUFFIX="_stanli"
fi
STANLI_LIB="${IGC_STANLI_LIB:-/mnt/lustre/users/${HPC_GROUP}/${HPC_USER}/cogmod_stanli/R_libs_0.22.2}"
MAIL_USER="${IGC_MAIL_USER:-${HPC_USER}@sussex.ac.uk}"

# Environment modules / R library used by the jobs. CmdStanR/0.7.1 is the
# only module stack on Artemis that ships mgcv + brms + cmdstanr together;
# R_LIBS adds what it does not ship (datawizard, cogmod, a newer cmdstanr).
R_MODULE="${IGC_R_MODULE:-CmdStanR/0.7.1-foss-2023a-R-4.3.2}"
EB_MODULES="${IGC_EB_MODULES:-/mnt/shared/easybuild/modules/all}"
R_LIBS_DIR="${IGC_R_LIBS:-/mnt/lustre/users/${HPC_GROUP}/${HPC_USER}/cluster_R_libs/x86_64-pc-linux-gnu-library/4.3}"

# Which cogmod the cluster library tracks. 'dev', which is 0.3.5: new fits use
# it (decision 2026-10-12, AGENT.md 2), and fit_model.R refuses anything below
# IGC_COGMOD_MIN (default 0.3.5).
COGMOD_REF="${IGC_COGMOD_REF:-dev}"

# Passed through to fit_model.R. Default "never" resumes a killed array by
# skipping shards that already exist; IGC_FILE_REFIT=always forces a clean
# refit after a formula or data change.
FILE_REFIT="${IGC_FILE_REFIT:-never}"

# models_stanli/ for IGC_BACKEND=stanli, whose fits have the production names.
LOCAL_MODELS="${HERE}/../models${BACKEND_SUFFIX}"

# Prefer Windows OpenSSH when present (Git Bash's ssh also works).
if [ -x /c/Windows/System32/OpenSSH/ssh.exe ]; then
  SSH=/c/Windows/System32/OpenSSH/ssh.exe
  SCP=/c/Windows/System32/OpenSSH/scp.exe
else
  SSH=ssh
  SCP=scp
fi

die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }
info() { printf '\033[36m==>\033[0m %s\n' "$*"; }

remote() { "$SSH" "$HPC_ALIAS" "$@"; }

require_link() {
  remote true 2>/dev/null || die "cannot reach ${HPC_ALIAS}.
  Is the GlobalProtect VPN connected (portal bond.sussex.ac.uk)?
  Run './hpc check' for detail."
}

# The model names, read out of models.R -- which is the single definition of
# what a model is. Relies on the declaration lines being '  <name> = list('
# at two-space indent, as models.R's header says.
list_models() {
  sed -n 's/^  \([A-Za-z_][A-Za-z0-9_]*\) = list($/\1/p' "${HERE}/models.R"
}

# Expand 'all' to every model; validate anything else against models.R so a
# typo fails here and not eight hours into a job.
# Several at once as a comma-separated list, gam_a,gam_b, so that a batch is
# one SSH connection rather than one per model (the login node starts refusing
# connections after a burst -- 2026-09-28). Every name is checked before
# anything is submitted.
resolve_models() {
  local want="${1:-}" known m w found
  known="$(list_models)"
  [ -n "$known" ] || die "no models found in models.R"
  [ -n "$want" ] || die "which model? one of: $(echo $known) (or 'all', or a comma-separated list)"
  if [ "$want" = all ]; then echo "$known"; return; fi
  for w in ${want//,/ }; do
    found=0
    for m in $known; do [ "$m" = "$w" ] && found=1; done
    [ "$found" = 1 ] || die "unknown model '${w}'. Known: $(echo $known)"
  done
  echo "${want//,/ }"
}

# --- commands --------------------------------------------------------------

cmd_check() {
  info "resolving ood.artemis.hrc.sussex.ac.uk"
  getent hosts ood.artemis.hrc.sussex.ac.uk 2>/dev/null || nslookup ood.artemis.hrc.sussex.ac.uk 2>/dev/null | tail -3 || true
  info "testing SSH to '${HPC_ALIAS}'"
  if remote 'echo "  connected as $(whoami) on $(hostname)"; echo "  quota:"; df -h '"${USERS_DIR%/$PROJECT}"' '"${SCRATCH_DIR%/$PROJECT}"' 2>/dev/null | sed "s/^/    /"'; then
    printf '\033[32mOK\033[0m -- SSH to Artemis works.\n'
  else
    die "SSH failed. Check: (1) VPN connected, (2) public key in ~/.ssh/authorized_keys on Artemis."
  fi
}

cmd_setup() {
  require_link
  info "creating project directories"
  remote "mkdir -p '${USERS_DIR}' '${MODELS_DIR}' '${MODELS_DIR}/combined' '${MODELS_DIR}/predictions' '${SCRATCH_DIR}' && ls -la '${USERS_DIR}'"
}

cmd_push() {
  require_link
  info "pushing scripts to ${USERS_DIR}"
  # One SSH connection for the whole push: sshd here rate-limits bursts of
  # connections (they fail with "kex_exchange_identification: Connection
  # reset"), so stream everything through a single tar pipe rather than
  # opening a connection per file.
  local tmp f base names=()
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' RETURN
  for f in "$HERE"/*.R "$HERE"/*.slurm; do
    [ -e "$f" ] || continue
    base="$(basename "$f")"
    sed 's/\r$//' "$f" > "$tmp/$base"   # strip CR: CRLF breaks bash/Rscript
    names+=("$base")
    printf '    %s\n' "$base"
  done
  [ ${#names[@]} -gt 0 ] || die "nothing to push"
  # Mirror rather than merge: a renamed script left behind on the cluster is
  # still submittable, and a stale make.slurm that fits the wrong thing for two
  # days is an expensive way to find that out. Only top-level *.R / *.slurm are
  # touched; models/, tests/ and the logs are left alone.
  tar -C "$tmp" -cf - "${names[@]}" | remote "
    mkdir -p '${USERS_DIR}' &&
    tar -C '${USERS_DIR}' -xf - &&
    chmod +x '${USERS_DIR}'/*.slurm 2>/dev/null
    cd '${USERS_DIR}' || exit 1
    for f in *.R *.slurm; do
      [ -e \"\$f\" ] || continue
      case ' ${names[*]} ' in
        *\" \$f \"*) ;;
        *) echo \"    removing stale \$f\"; rm -f \"\$f\" ;;
      esac
    done
    ls -la '${USERS_DIR}'"
}

cmd_install() {
  require_link
  # Compiling on the login node is antisocial (and gets throttled), so this
  # runs through srun on a compute node. Any package named on the command line
  # is force-reinstalled -- that is how cogmod is refreshed from GitHub.
  local forced="$*"
  info "installing R packages on a compute node (cogmod@${COGMOD_REF})${forced:+ (forcing: ${forced})}"
  remote "cd '${USERS_DIR}' && srun \
    --partition='${IGC_INSTALL_PARTITION:-short}' \
    --time='${IGC_INSTALL_TIME:-02:00:00}' \
    --cpus-per-task=4 --mem=16G \
    --job-name=igc_install \
    bash -c '
      . /etc/profile.d/lmod.sh
      module use \"${EB_MODULES}\"
      module load \"${R_MODULE}\"
      export IGC_R_LIBS=\"${R_LIBS_DIR}\"
      export IGC_COGMOD_REF=\"${COGMOD_REF}\"
      export IGC_COGMOD_MIN=\"${IGC_COGMOD_MIN:-0.3.5}\"
      export IGC_FORCE=\"${forced}\"
      Rscript install_pkgs.R
    '"
}

cmd_precompile() {
  require_link
  # Build the shared CmdStan PCH once on a single node. Launching a cold array
  # makes every task race to write the same ~800 MB .gch file, and all but one
  # die with "while reading precompiled header: No such file or directory".
  info "building the CmdStan precompiled header (one node, a few minutes)"
  remote "cd '${USERS_DIR}' && srun \
    --partition='${IGC_INSTALL_PARTITION:-short}' \
    --time='${IGC_PRECOMPILE_TIME:-01:00:00}' \
    --cpus-per-task=4 --mem=16G \
    --job-name=igc_precompile \
    bash -c '
      . /etc/profile.d/lmod.sh
      module use \"${EB_MODULES}\"
      module load \"${R_MODULE}\"
      export R_LIBS=\"${R_LIBS_DIR}\"
      Rscript precompile.R
    '"
}

cmd_models() {
  local m
  for m in $(list_models); do printf '  %s\n' "$m"; done
}

# sbatch one .slurm per model. Everything that differs between models is on
# the command line -- job name, log names, IGC_MODEL -- so the .slurm files
# stay generic and nothing is hard-coded to one account.
submit_per_model() {
  local script="$1" tag="$2" want="$3"; shift 3
  local models model
  models="$(resolve_models "$want")"
  require_link
  # Forward run-shaping vars when the caller sets them, e.g.
  #   IGC_NPARTICIPANTS=30 IGC_WARMUP=300 ./hpc fit gam_lnr_mullerlyer
  #   IGC_CRITERION=waic IGC_CRITERION_NDRAWS=1500 ./hpc combine gam_lnr_mullerlyer
  local extra="" v val
  for v in IGC_NPARTICIPANTS IGC_WARMUP IGC_SAMPLES IGC_CHAINS IGC_COGMOD_MIN \
           IGC_CRITERION IGC_CRITERION_NDRAWS IGC_DELETE_SHARDS IGC_LOO_BLOCK; do
    eval "val=\${$v:-}"
    [ -n "$val" ] && extra="${extra},${v}='${val}'"
  done
  [ "$BACKEND" = stanli ] && extra="${extra},IGC_BACKEND='stanli',IGC_STANLI_LIB='${STANLI_LIB}'"
  # ... and every prediction setting, e.g. IGC_PRED_PPC_NDRAWS=1000
  for v in $(compgen -v IGC_PRED_ || true); do
    eval "val=\${$v:-}"
    [ -n "$val" ] && extra="${extra},${v}='${val}'"
  done
  # One remote shell for the whole batch. A failed sbatch (e.g. sussexneuro
  # rejecting a request over its group quota) is reported and the rest still go.
  local cmds="mkdir -p '${SCRATCH_DIR}' '${MODELS_DIR}' && cd '${USERS_DIR}' || exit 1"
  for model in $models; do
    cmds="${cmds}
printf '\033[36m==>\033[0m submitting %s for %s\n' '${script}' '${model}'
sbatch \
      --chdir='${USERS_DIR}' \
      --job-name='igc_${tag}_${model}${BACKEND_SUFFIX}' \
      --output='${SCRATCH_DIR}/${tag}_${model}${BACKEND_SUFFIX}_%A_%a.out' \
      --error='${SCRATCH_DIR}/${tag}_${model}${BACKEND_SUFFIX}_%A_%a.err' \
      --mail-user='${MAIL_USER}' \
      --export=ALL,IGC_MODEL='${model}',IGC_USERS_DIR='${USERS_DIR}',IGC_SCRATCH_DIR='${SCRATCH_DIR}',IGC_MODELS_DIR='${MODELS_DIR}',IGC_R_MODULE='${R_MODULE}',IGC_R_LIBS='${R_LIBS_DIR}',IGC_EB_MODULES='${EB_MODULES}',IGC_FILE_REFIT='${FILE_REFIT}'${extra} \
      $* '${script}' || echo '  !! sbatch failed for ${model}'"
  done
  remote "$cmds"
}

cmd_fit() {
  local want="${1:-}"; shift || true
  submit_per_model fit.slurm fit "$want" "$@"
}

cmd_combine() {
  local want="${1:-}"; shift || true
  submit_per_model combine.slurm combine "$want" "$@"
}

cmd_predict() {
  local want="${1:-}"; shift || true
  submit_per_model predict.slurm predict "$want" "$@"
}

# Not per model: one short job loops over the combined fits (prior_check.R),
# since each takes about a minute.
cmd_priors() {
  local want="${1:-all}"; shift || true
  require_link
  local force=""
  [ -n "${IGC_PRIORS_FORCE:-}" ] && force=",IGC_PRIORS_FORCE='${IGC_PRIORS_FORCE}'"
  remote "mkdir -p '${SCRATCH_DIR}' && cd '${USERS_DIR}' && sbatch       --chdir='${USERS_DIR}'       --job-name='igc_priors_${want}'       --output='${SCRATCH_DIR}/priors_${want}_%j.out'       --error='${SCRATCH_DIR}/priors_${want}_%j.err'       --mail-user='${MAIL_USER}'       --export=ALL,IGC_MODEL='${want}',IGC_MODELS_DIR='${MODELS_DIR}',IGC_R_MODULE='${R_MODULE}',IGC_R_LIBS='${R_LIBS_DIR}',IGC_EB_MODULES='${EB_MODULES}'${force}       $* priors.slurm"
}

# Move one generation of fits out of the way of the next. fit_model.R reuses
# a shard that already exists (file_refit = "never"), so a refit with the old
# shards still in models/ would adopt them rather than fit anything. Every
# script reads models/, models/combined/ and so on non-recursively, so a
# subdirectory is out of their reach. Nothing is deleted.
cmd_archive() {
  require_link
  local label="${1:-$(date +%Y%m%d)}"
  local dest="${MODELS_DIR}/old_${label}"
  info "moving the fits in ${MODELS_DIR} into ${dest}/"
  remote "
    cd '${MODELS_DIR}' 2>/dev/null || { echo '  no models directory: nothing to archive'; exit 0; }
    # A fit still running would write its old-generation shard into the new one.
    if squeue -h -u '${HPC_USER}' -o '%j' | grep -q '^igc_'; then
      echo '  refusing: igc_ jobs are queued or running (./hpc queue)' >&2; exit 1
    fi
    if [ -e '${dest}' ]; then echo '  refusing: ${dest} already exists' >&2; exit 1; fi
    mkdir -p '${dest}' || exit 1
    n=0
    for f in *.rds; do
      [ -e \"\$f\" ] || continue
      mv -n \"\$f\" '${dest}/' && n=\$((n + 1))
    done
    echo \"    \$n shards\"
    for d in combined predictions priors stan_csv; do
      [ -d \"\$d\" ] || continue
      if [ -n \"\$(ls -A \"\$d\")\" ]; then
        echo \"    \$d/: \$(ls \"\$d\" | wc -l) entries\"
        mv \"\$d\" '${dest}/' && mkdir \"\$d\"
      fi
    done
    du -sh '${dest}'
    echo '  left in ${MODELS_DIR}:'; ls -la"
}

# Where a running fit stands, days before its REPORT line. During warmup only
# the .out says anything: cmdstanr's "Chain N Iteration: i / n" lines. Once a
# chain has finished warmup, its CmdStan CSV in models/stan_csv/ holds the
# adapted step size and every draw so far. That is enough to see the two
# failures of AGENT.md 4.10 early: a frozen chain (step size far below its
# siblings') and chains in separate modes (lp__ levels hundreds apart, where
# chains in one mode differ by a fraction of their own sd).
cmd_progress() {
  local models
  models="$(resolve_models "${1:-}")"
  require_link
  # A quoted heredoc fed to bash -s, so awk's $ fields need no escaping.
  remote "bash -s -- '${MODELS_DIR}' '${SCRATCH_DIR}' '${HPC_USER}' '${BACKEND_SUFFIX}' ${models}" <<'EOF'
models_dir=$1; scratch=$2; user=$3; sfx=$4; shift 4
secs() { awk -F'[-:]' '{ s = 0; for (i = 1; i <= NF; i++) s = s * (i == NF - 2 && NF == 4 ? 24 : 60) + $i; print s }'; }
for m in "$@"; do
  echo "== $m$sfx"
  jobs=$(squeue -h -u "$user" -n "igc_fit_$m$sfx" -o '%F' | sort -u)
  [ -n "$jobs" ] || { echo "   no fit job queued or running"; continue; }
  for j in $jobs; do
    squeue -h -r -j "$j" -o '%K|%T|%M|%N|%r' | sort -n | while IFS='|' read -r t state elapsed node reason; do
      if [ "$state" != RUNNING ]; then echo "   shard $t: $state ($reason)"; continue; fi
      out="$scratch/fit_${m}${sfx}_${j}_${t}.out"
      # "chain 1 900/2500  chain 2 1000/2500  |900|2500": the slowest chain sets the ETA.
      # stanli writes "Chain [1] Iteration:", cmdstanr "Chain 1 Iteration:".
      its=$(grep -o 'Chain \[*[0-9]*\]* Iteration: *[0-9]* / [0-9]*' "$out" 2>/dev/null |
            awk '{ gsub(/[][]/, "", $2); it[$2] = $4; n = $6 } END { lo = n; for (c in it) { printf "chain %s %s/%s  ", c, it[c], n; if (it[c] < lo) lo = it[c] }; if (n) print "|" lo "|" n }')
      done_it=$(echo "$its" | awk -F'|' 'NF == 3 { print $2 }'); total=$(echo "$its" | awk -F'|' 'NF == 3 { print $3 }')
      eta=""
      # Not from iteration 1, which is printed after the compile and data load.
      if [ -n "$done_it" ] && [ "$done_it" -ge 100 ]; then
        s=$(echo "$elapsed" | secs)
        eta=$(awk -v s="$s" -v d="$done_it" -v n="$total" 'BEGIN { t = s * (n - d) / d
          if (t >= 86400) printf "~%.1f days to go", t / 86400; else printf "~%.1f h to go", t / 3600 }')
      fi
      [ -n "$its" ] || its="no iteration line yet"
      echo "   shard $t on $node, running $elapsed: ${its%%|*}${eta}"
      for csv in "$models_dir"/stan_csv/"$m"_[A-Z]*_"$t"_"$j"/*.csv; do
        [ -e "$csv" ] || continue
        step=$(grep -m1 '^# Step size' "$csv" | sed 's/.*= *//')
        [ -n "$step" ] || continue # still in warmup
        chain=$(basename "$csv" .csv | awk -F- '{ print $(NF - 1) }')
        grep -v '^#' "$csv" | tail -n +2 | cut -d, -f1,4,6 |
          awk -F, -v s="$step" -v c="$chain" '
            { n++; lp[n] = $1; td += $2; dv += $3 }
            END {
              if (!n) { printf "     chain %s: step %s, no draws yet\n", c, s; exit }
              for (i = 1; i <= n; i++) mu += lp[i] / n
              for (i = 1; i <= n; i++) v += (lp[i] - mu)^2
              printf "     chain %s: step %s, %d draws, lp__ %.0f (sd %.0f), treedepth %.1f, %d divergent\n",
                c, s, n, mu, sqrt(v / (n > 1 ? n - 1 : 1)), td / n, dv
            }'
      done
    done
  done
done
EOF
}

cmd_queue() {
  require_link
  remote "squeue -u '${HPC_USER}' -o '%.10i %.12P %.28j %.8T %.12M %.12L %R'"
}

cmd_log() {
  require_link
  local key="${1:-}"
  if [ -n "$key" ]; then
    remote "for f in '${SCRATCH_DIR}'/*${key}*; do echo \"===== \$f =====\"; tail -n 40 \"\$f\"; done"
  else
    remote "cd '${SCRATCH_DIR}' 2>/dev/null || exit 1
      for f in \$(ls -t *.out *.err 2>/dev/null | head -4); do
        echo \"===== \$f (\$(stat -c %y \"\$f\" | cut -d. -f1)) =====\"; tail -n 30 \"\$f\"; echo;
      done"
  fi
}

cmd_ls() {
  require_link
  remote "ls -lh '${MODELS_DIR}'/*.rds '${MODELS_DIR}'/combined/*.rds '${MODELS_DIR}'/predictions/*.rds 2>/dev/null || echo '  (no .rds yet)'"
}

cmd_pull() {
  require_link
  local pattern="${1:-combined/*.rds}" dest="$LOCAL_MODELS"
  # The prediction files keep their own directory locally too: they have the
  # same names as the fits they were made from, so one landing in models/
  # would overwrite its fit. So anything under predictions/ goes there, asked
  # for as 'predictions' or as a path such as 'predictions/gam_lnr_*.rds'
  # (until 2026-09-28 only the bare word did).
  case "$pattern" in
    predictions)   pattern="predictions/*.rds"; dest="$LOCAL_MODELS/predictions" ;;
    predictions/*) dest="$LOCAL_MODELS/predictions" ;;
    priors)        pattern="priors/*.rds"; dest="$LOCAL_MODELS/priors" ;;
    priors/*)      dest="$LOCAL_MODELS/priors" ;;
  esac
  mkdir -p "$dest"
  info "pulling '${pattern}' into ${dest#"$HERE/../"}/"
  # -p keeps the modification times, which the qmd compares against
  "$SCP" -p "${HPC_ALIAS}:${MODELS_DIR}/${pattern}" "$dest/" || die "nothing matched '${pattern}'"
  ls -lh "$dest"
}

cmd_cancel() {
  require_link
  local target="${1:?usage: ./hpc cancel <jobid|all>}"
  if [ "$target" = all ]; then
    remote "scancel -u '${HPC_USER}' && echo 'cancelled all jobs for ${HPC_USER}'"
  else
    remote "scancel '${target}' && echo 'cancelled ${target}'"
  fi
}

cmd_sh() {
  require_link
  remote "${1:?usage: ./hpc sh '<command>'}"
}

# --- dispatch --------------------------------------------------------------

case "${1:-}" in
  check)      shift; cmd_check "$@" ;;
  setup)      shift; cmd_setup "$@" ;;
  push)       shift; cmd_push "$@" ;;
  install)    shift; cmd_install "$@" ;;
  precompile) shift; cmd_precompile "$@" ;;
  models)     shift; cmd_models "$@" ;;
  fit)        shift; cmd_fit "$@" ;;
  combine)    shift; cmd_combine "$@" ;;
  predict)    shift; cmd_predict "$@" ;;
  priors)     shift; cmd_priors "$@" ;;
  archive)    shift; cmd_archive "$@" ;;
  progress)   shift; cmd_progress "$@" ;;
  queue)      shift; cmd_queue "$@" ;;
  log)        shift; cmd_log "$@" ;;
  ls)         shift; cmd_ls "$@" ;;
  pull)       shift; cmd_pull "$@" ;;
  cancel)     shift; cmd_cancel "$@" ;;
  sh)         shift; cmd_sh "$@" ;;
  *) sed -n '2,41p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
esac
